# Local development only. Change these values before any shared deployment.
POSTGRES_DB=knowflow
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=knowflow_local_only

KNOWFLOW_APP_ENV=development
KNOWFLOW_DATABASE_URL=postgresql+psycopg://knowflow:knowflow_local_only@db:5432/knowflow
KNOWFLOW_ALLOWED_ORIGINS=["http://localhost:3000"]

WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ROOT_USER=knowflow_local
MINIO_ROOT_PASSWORD=knowflow_minio_local_only
MINIO_BUCKET=knowflow-documents
MINIO_ENDPOINT=http://object-store:9000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_INTERNAL_BASE_URL=http://api:8000

# Configurable defaults. M3-M6 apply upload, processing, retrieval, and evidence settings.
KNOWFLOW_MAX_UPLOAD_BYTES=20971520
KNOWFLOW_MAX_PDF_PAGES=250
KNOWFLOW_CHUNK_SIZE_CHARS=1800
KNOWFLOW_CHUNK_OVERLAP_CHARS=240
KNOWFLOW_MAX_QUESTION_CHARS=2000
KNOWFLOW_KEYWORD_CANDIDATES=30
KNOWFLOW_VECTOR_CANDIDATES=30
KNOWFLOW_RETRIEVAL_TOP_K=6
KNOWFLOW_RRF_K=60
KNOWFLOW_EMBEDDING_MODEL=intfloat/e5-small-v2
KNOWFLOW_EMBEDDING_REVISION=ffb93f3bd4047442299a41ebb6fa998a38507c52
KNOWFLOW_EMBEDDING_DIMENSIONS=384
KNOWFLOW_EMBEDDING_VERSION=v1
KNOWFLOW_EMBEDDING_CACHE_DIR=/models
KNOWFLOW_EMBEDDING_DEVICE=cpu
KNOWFLOW_EMBEDDING_BATCH_SIZE=16
KNOWFLOW_PROCESSING_JOB_TIMEOUT_SECONDS=600
KNOWFLOW_WORKER_MAX_ATTEMPTS=4
KNOWFLOW_WORKER_RETRY_BACKOFF_SECONDS=[30,120,600]
KNOWFLOW_CLEANUP_RETRY_WINDOW_HOURS=24
KNOWFLOW_TOMBSTONE_RETENTION_DAYS=7
KNOWFLOW_JOB_LEASE_SECONDS=90
KNOWFLOW_JOB_HEARTBEAT_SECONDS=30
KNOWFLOW_RATE_LIMIT_QUESTIONS_PER_MINUTE=20
KNOWFLOW_RATE_LIMIT_QUESTION_BURST=5
KNOWFLOW_RATE_LIMIT_UPLOADS_PER_HOUR=10
KNOWFLOW_RATE_LIMIT_UPLOAD_BYTES_PER_HOUR=104857600
KNOWFLOW_RATE_LIMIT_AUTH_FAILURES_PER_IP=10
KNOWFLOW_RATE_LIMIT_AUTH_WINDOW_SECONDS=300
KNOWFLOW_MAX_SEARCH_RESULTS=20
KNOWFLOW_SEARCH_PAGE_SIZE=10
KNOWFLOW_EVIDENCE_SUPPORTING_LIMIT=3
KNOWFLOW_EVIDENCE_DEDUP_JACCARD_THRESHOLD=0.72
KNOWFLOW_EVIDENCE_MINIMUM_QUERY_TERM_OVERLAP=2
KNOWFLOW_EVIDENCE_MINIMUM_QUERY_COVERAGE=0.6
KNOWFLOW_EVIDENCE_MINIMUM_VECTOR_SIMILARITY=0.72
KNOWFLOW_AUTH_ACCESS_TOKEN_SECONDS=900
KNOWFLOW_APP_SESSION_MAX_AGE_SECONDS=604800
KNOWFLOW_APP_SESSION_IDLE_TIMEOUT_SECONDS=43200

# WorkOS AuthKit staging environment. Obtain the client ID/API key from WorkOS.
# Generate the cookie password with: openssl rand -base64 32
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
WORKOS_COOKIE_MAX_AGE=604800
WORKOS_COOKIE_SAMESITE=lax
# Add this exact `aud` value to the WorkOS environment JWT template.
WORKOS_TOKEN_AUDIENCE=https://api.knowflow.example
# Optional: set if WorkOS is configured with a custom issuer/domain.
WORKOS_ISSUER=
